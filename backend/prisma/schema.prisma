// schema.prisma — CANONICAL (Vintus Performance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athleteProfile  AthleteProfile?
  subscription    Subscription?
  nutritionSubscription NutritionSubscription?
  messageLogs     MessageLog[]
  escalationEvents EscalationEvent[]
  deviceConnections DeviceConnection[]
  sessions        Session[]
  chatConversation ChatConversation?
  sessionBookings SessionBooking[]
  macroCalculatorAddon MacroCalculatorAddon?
}

enum Role {
  CLIENT
  ADMIN
  COACH
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// ATHLETE PROFILE & INTAKE
// ============================================================

model AthleteProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Intake survey data
  firstName       String
  lastName        String
  phone           String?
  smsConsent      Boolean  @default(false)
  timezone        String   @default("America/New_York")
  dateOfBirth     DateTime?

  // Goals & context
  primaryGoal     String        // build-muscle | lose-fat | endurance | recomposition | well-rounded
  secondaryGoals  String[]      // array of goals
  trainingDaysPerWeek Int
  preferredTrainingTime String? // morning | midday | evening
  experienceLevel String        // beginner | intermediate | advanced | elite
  currentActivity String?       // description of current routine
  equipmentAccess String        // full-gym | home-gym | minimal | bodyweight-only
  injuryHistory   String?       // free text
  sleepSchedule   String?       // e.g. "11pm-6:30am"
  stressLevel     Int?          // 1-10
  occupation      String?
  travelFrequency String?       // rarely | monthly | weekly
  biggestChallenge String?      // structure | no-results | energy | unsure | free text

  // Admin controls
  messagingDisabled Boolean @default(false)
  adminNotes      String?       // Private admin-only notes — NEVER exposed to client or AI

  // Highest 30-day milestone (30, 60, 90...) whose report has already been
  // shown/acknowledged, so the dashboard doesn't re-show it every visit.
  lastMilestoneDay Int @default(0)

  // AI classification output
  personaType     String?       // executive-athlete | endurance-competitor | hybrid-builder | recovery-first
  aiSummary       String?       // AI-generated summary paragraph
  riskFlags       String[]      // injury, overtraining, etc.

  // Routine questionnaire (post-purchase)
  wakeTime        String?
  bedTime         String?
  mealsPerDay     Int?
  hydrationLevel  String?       // low | moderate | good
  supplementsUsed String?
  recoveryPractices String[]    // foam-roll | stretch | sauna | cold-plunge | massage | none

  // Physical Profile (expanded onboarding)
  gender            String?       // male | female — used for BMR/calorie-target calculation (Mifflin-St Jeor)
  heightInches      Int?
  weightLbs         Float?
  bodyFatEstimate   String?       // under-15 | 15-20 | 20-25 | 25-30 | 30-plus | unsure

  // Training Background
  yearsTraining     Int?
  currentProgram    String?
  benchPressMax     String?       // never-tested | under-135 | 135-185 | 185-225 | 225-275 | 275-315 | 315-plus
  squatMax          String?
  deadliftMax       String?
  cardioBase        String?       // none | light-walks | can-run-1mi | can-run-3mi | can-run-5mi-plus
  exercisesLoved    String?
  exercisesHated    String?

  // Lifestyle
  workType          String?       // desk | on-feet | physical-labor | mixed | remote
  sessionLength     Int?          // preferred minutes: 30 | 45 | 60 | 75 | 90
  specificInjuries  Json?         // [{ area, severity, notes }]
  dietaryApproach   String?       // no-restriction | high-protein | keto | vegan | vegetarian | paleo | iifym
  alcoholFrequency  String?       // never | rare | 1-2-per-week | 3-5-per-week | daily
  caffeineDaily     String?       // none | 1-cup | 2-3-cups | 4-plus-cups

  // Nutrition Profile (Nutrition Plan tiers) — drives calorie/macro calculation
  // and AI meal-plan generation, separate from dietaryApproach/chronicConditions above.
  activityLevel     String?       // sedentary | light | moderate | active | very-active
  nutritionGoals    String?       // free text — what they want out of this plan; classified
                                   // into calorie direction/magnitude + protein emphasis
  foodAllergies     String?       // free text — safety-critical, kept distinct from chronicConditions
  foodsLoved        String?
  foodsHated        String?
  cookingSkill      String?       // beginner | intermediate | advanced
  mealPrepTime      String?       // minimal | moderate | extensive
  foodBudget        String?       // budget-conscious | moderate | no-constraint

  // Goal Specifics
  targetWeight      Float?
  goalTimeline      String?       // 30-days | 60-days | 90-days | 4-months | 6-months | 12-months | event-date
  eventDate         DateTime?
  eventDescription  String?

  // Health
  chronicConditions String?
  medications       String?
  previousPT        Boolean?

  // Private Coaching liability waiver (see legal/private-coaching-waiver-DRAFT.md)
  waiverAcceptedAt  DateTime?
  waiverVersion     String?

  // Client-editable training preferences (post-purchase, via dashboard's
  // "Edit My Preferences") — standing rest days the plan rebuilds around
  // going forward. JS Date.getDay() convention: 0=Sunday .. 6=Saturday.
  restDayPreferences Int[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  readinessMetrics  ReadinessMetric[]
  workoutPlans      WorkoutPlan[]
  nutritionPlans    NutritionPlan[]
  nutritionCheckIns NutritionCheckIn[]
  nutritionFavorites NutritionFavorite[]
}

// ============================================================
// READINESS & DAILY DATA
// ============================================================

model ReadinessMetric {
  id              String   @id @default(cuid())
  athleteProfileId String
  athleteProfile  AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date
  source          DataSource @default(MANUAL)

  // Core metrics (nullable — not all sources provide all)
  hrvMs           Float?       // HRV in milliseconds
  restingHr       Int?         // bpm
  sleepScore      Float?       // 0-100
  sleepDurationMin Int?
  fatigueScore    Float?       // 0-100 (higher = more fatigued)
  stressScore     Float?       // 0-100
  caloriesBurned  Int?
  steps           Int?
  vo2Estimate     Float?
  trainingLoad    Float?       // TSS or equivalent
  bodyWeight      Float?       // kg

  // Manual check-in fields (MVP before wearables)
  perceivedEnergy   Int?       // 1-10
  perceivedSoreness Int?       // 1-10
  perceivedMood     Int?       // 1-10
  sleepQualityManual Int?      // 1-10
  notes             String?

  createdAt       DateTime @default(now())

  @@unique([athleteProfileId, date, source])
}

enum DataSource {
  MANUAL
  STRAVA
  GARMIN
  APPLE_HEALTH
  WHOOP
  OURA
  FITBIT
  TRAININGPEAKS
}

// ============================================================
// WORKOUT PLAN & SESSIONS
// ============================================================

model WorkoutPlan {
  id              String   @id @default(cuid())
  athleteProfileId String
  athleteProfile  AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  name            String         // e.g. "Week 3 — Build Phase"
  weekNumber      Int
  blockType       String         // base | build | peak | deload | recovery
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  isActive        Boolean  @default(true)

  plannedTSS      Float?         // weekly target training stress
  actualTSS       Float?         // accumulated

  sessions        WorkoutSession[]
  adjustmentLogs  AdjustmentLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WorkoutSession {
  id              String   @id @default(cuid())
  workoutPlanId   String
  workoutPlan     WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  scheduledDate   DateTime @db.Date
  scheduledOrder  Int            // 1, 2, 3... for day ordering
  sessionType     SessionType
  title           String         // e.g. "Upper Body Strength A"
  description     String?        // coach notes / AI explanation
  prescribedDuration Int?        // minutes
  prescribedTSS   Float?

  // Workout content (JSON — exercises, sets, reps, zones, etc.)
  content         Json           // structured workout data

  // Per-exercise check-off state as the client works through the session --
  // { warmup: number[], main: number[], cooldown: number[] } of checked
  // indices into that section's content array. Separate from `status`
  // (whole-session completion) and from `content` itself so swapping an
  // exercise never risks clobbering check-off progress.
  completedExercises Json?

  // Completion tracking
  status          SessionStatus @default(SCHEDULED)
  completedAt     DateTime?
  actualDuration  Int?           // minutes
  actualTSS       Float?
  rpe             Int?           // rate of perceived exertion 1-10
  athleteNotes    String?

  // If rescheduled
  originalDate    DateTime? @db.Date
  rescheduledFrom String?        // ID of session this replaced

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum SessionType {
  STRENGTH_UPPER
  STRENGTH_LOWER
  STRENGTH_FULL
  STRENGTH_PUSH
  STRENGTH_PULL
  ENDURANCE_ZONE2
  ENDURANCE_TEMPO
  ENDURANCE_INTERVALS
  HIIT
  MOBILITY_RECOVERY
  ACTIVE_RECOVERY
  REST
  CUSTOM
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  SKIPPED
  RESCHEDULED
}

// ============================================================
// NUTRITION PLAN (NUTRITION_4WEEK / NUTRITION_8WEEK tiers)
// ============================================================

model NutritionPlan {
  id              String   @id @default(cuid())
  athleteProfileId String
  athleteProfile  AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  tier            String         // NUTRITION_4WEEK | NUTRITION_8WEEK
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  isActive        Boolean  @default(true)

  // Calculated targets (Mifflin-St Jeor BMR + activity multiplier + goal adjustment)
  dailyCalories   Int
  proteinG        Int
  carbsG          Int
  fatG            Int

  mealTiming      String         // AI-generated guidance on when/how to eat
  sampleMeals     Json           // ChecklistItem[] -- one representative day, shown as "Today's Plan"
  mealRotation    Json?          // ChecklistItem[][] -- 2-3 distinct day-variants (sampleMeals is variant 0) used to
                                  // compute a realistic weekly grocery list instead of assuming one day repeated x7.
                                  // Null on plans generated before this existed -- grocery list falls back to sampleMeals x7.
  supplementNotes String?        // AI-generated, general — never a medical recommendation
  coachNotes      String?        // short AI rationale summary, shown to client

  source          String   @default("ai") // "ai" | "fallback" — surfaced to admin if the AI call failed

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A meal the client explicitly liked enough to keep — biases future
// shuffles/rotation/Meal Ideas toward similar (not identical) suggestions,
// and gets slotted back into the rotation occasionally, not every day.
model NutritionFavorite {
  id              String   @id @default(cuid())
  athleteProfileId String
  athleteProfile  AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  mealType        String   // breakfast | lunch | dinner | snack
  title           String
  foods           Json     // string[]
  instructions    String?
  calories        Int
  proteinG        Int
  carbsG          Int
  fatG            Int

  createdAt       DateTime @default(now())

  @@unique([athleteProfileId, title])
}

// Which checklist items a client actually checked off on a given day —
// makes nutrition adherence/streak real, persisted data instead of a
// client-side-only visual toggle that resets on reload.
model NutritionCheckIn {
  id               String   @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  date             DateTime @db.Date
  completedIndices Int[]          // indices into that day's checklist that were checked
  totalItems       Int            // size of the checklist that day (plans can change size over time)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([athleteProfileId, date])
}

// ============================================================
// ADAPTIVE ADJUSTMENT LOG
// ============================================================

model AdjustmentLog {
  id              String   @id @default(cuid())
  workoutPlanId   String
  workoutPlan     WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  triggerEvent    String        // missed_workout | low_hrv | high_fatigue | low_sleep | travel_week | deload_trigger
  triggerData     Json?         // snapshot of the data that triggered this
  adjustmentType  String        // reschedule | reduce_volume | reduce_intensity | swap_session | add_recovery | advance_deload
  description     String        // human-readable explanation
  affectedSessions String[]    // IDs of sessions modified

  createdAt       DateTime @default(now())
}

// ============================================================
// ADHERENCE TRACKING
// ============================================================

model AdherenceRecord {
  id              String   @id @default(cuid())
  userId          String
  weekStartDate   DateTime @db.Date

  scheduledCount  Int
  completedCount  Int
  missedCount     Int
  skippedCount    Int
  adherenceRate   Float          // 0.0 - 1.0

  // Rolling window tracking
  consecutiveMissed Int @default(0)
  weeklyMissedStreak Int @default(0)

  escalationTriggered Boolean @default(false)

  createdAt       DateTime @default(now())

  @@unique([userId, weekStartDate])
}

// ============================================================
// MESSAGING
// ============================================================

model MessageLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel         MessageChannel
  category        MessageCategory
  templateId      String?        // which template was used
  content         String         // actual message sent
  metadata        Json?          // any extra context

  sentAt          DateTime @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  failureReason   String?

  // Twilio/Resend tracking
  externalId      String?        // SID or message ID from provider
}

enum MessageChannel {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum MessageCategory {
  WELCOME
  MOTIVATION
  HUMOR
  EDUCATION
  ACCOUNTABILITY
  RECOVERY_TIP
  WORKOUT_COMPLETED
  WORKOUT_MISSED
  ESCALATION
  CHECK_IN
  CHECKIN_RESPONSE
  SYSTEM
  DAILY_WORKOUT_ALERT
  WORKOUT_NOT_LOGGED
  PLAN_MILESTONE
  PLAN_ENDING
  PLAN_COMPLETED
  RENEWAL_FOLLOWUP
  COACH_APPROVAL_REQUEST
  PC_DAILY_PUSH
  PC_AFTERNOON_CHECKIN
  TRAINING_DAILY_PUSH
  NUTRITION_DAILY_PUSH
}

// ============================================================
// ESCALATION
// ============================================================

model EscalationEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  triggerReason   String         // 3_missed_workouts | no_checkin_5_days | high_fatigue_sustained
  escalationLevel Int            // 1 = nudge, 2 = concern, 3 = book call
  messageSent     Boolean @default(false)
  messageLogId    String?
  callBooked      Boolean @default(false)
  resolvedAt      DateTime?
  resolution      String?        // resumed | paused_subscription | churned | call_completed

  createdAt       DateTime @default(now())
}

// ============================================================
// SUBSCRIPTION & BILLING
// ============================================================

// Stripe webhook idempotency — the event.id itself is the dedup key, per
// Stripe's own recommendation, rather than inferring "already processed"
// from business-state comparisons (which incorrectly blocked legitimate
// tier upgrades — see checkout.service.ts).
model StripeWebhookEvent {
  id          String   @id // Stripe event.id
  type        String
  processedAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planTier        PlanTier
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?

  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)

  // Plan lifecycle tracking
  renewalPromptedAt  DateTime?
  renewalResponseAt  DateTime?
  scheduledDeleteAt  DateTime?

  // Coach-facing reminder to review/update next month's Private Coaching plan
  coachReminderSentAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A client's Nutrition Plan purchase (4-Week / 8-Week), tracked independently
// of the main Subscription (training/coaching) so a client can hold both
// simultaneously — e.g. a 60-Day Training Plan client who adds a Nutrition
// Plan on top. Same shape as Subscription minus fields that don't apply to
// nutrition (nutrition tiers activate immediately, no admin-approval gate).
model NutritionSubscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planTier        PlanTier // NUTRITION_4WEEK | NUTRITION_8WEEK — enforced at the app layer
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?

  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)

  renewalPromptedAt  DateTime?
  renewalResponseAt  DateTime?
  scheduledDeleteAt  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// $23 one-time add-on for Training Plan clients (30/60/90-day) who want
// calorie/macro targets without the full Nutrition Plan tier's meal plans
// and check-ins -- deliberately a flat number-only utility, not a
// subscription, so no periodEnd/status lifecycle like the models above.
// Gated at checkout/purchase time to Training Plan tiers only (Private
// Coaching and Nutrition Plan clients already have real nutrition guidance
// bundled in, so this would be redundant for them).
model MacroCalculatorAddon {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchasedAt     DateTime @default(now())
  stripeSessionId String?
  amountPaidCents Int      @default(2300)

  // Latest computed targets -- recalculable anytime from the dashboard tab
  calories        Int?
  proteinGrams    Int?
  carbGrams       Int?
  fatGrams        Int?

  // Inputs last used to compute the targets above, so the form can pre-fill
  weightLbs       Float?
  heightInches    Int?
  age             Int?
  gender          String?
  activityLevel   String?
  goalDirection   String?  // lose | maintain | gain

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PlanTier {
  PRIVATE_COACHING     // $997/mo recurring subscription
  TRAINING_30DAY       // $99 one-time, 30-day access
  TRAINING_60DAY       // $149 one-time, 60-day access
  TRAINING_90DAY       // $199 one-time, 90-day access
  NUTRITION_4WEEK      // $229 one-time, 28-day access
  NUTRITION_8WEEK      // $399 one-time, 56-day access
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_APPROVAL
  PAST_DUE
  CANCELED
  PAUSED
  TRIALING
}

// ============================================================
// DEVICE CONNECTIONS
// ============================================================

model DeviceConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        DataSource
  accessToken     String?        // encrypted
  refreshToken    String?        // encrypted
  externalUserId  String?
  scopes          String[]
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  syncErrors      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}

// ============================================================
// Lead — Contact form + Consultation booking requests
// ============================================================

model Lead {
  id             String   @id @default(cuid())
  type           String   // "CONTACT" | "CONSULTATION"
  firstName      String
  lastName       String?
  email          String
  phone          String?
  interest       String?  // contact form
  goals          String?  // contact form
  referral       String?  // contact form
  preferredDate  String?  // booking
  preferredTime  String?  // booking
  tier           String?  // booking (e.g. "PRIVATE_COACHING")
  primaryGoal    String?  // from quiz data
  experience     String?  // from quiz data
  notes          String?
  status         String   @default("NEW")
  meetLink       String?  // Google Meet link for CONSULTATION bookings
  reminderSentAt DateTime? // admin SMS "meeting in 1 hour" reminder — set once sent, dedup guard
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// PAID SESSIONS — one-off bookable training/coaching calls
// (distinct from Subscription/PlanTier — no client account required)
// ============================================================

model SessionBooking {
  id                String   @id @default(cuid())

  sessionType       PaidSessionType
  headcount         Int      @default(1)
  totalAmountCents  Int            // server-computed, never trust client input

  // Set only for the free PC_WEEKLY_CALL type — an authenticated Private
  // Coaching client booking their included weekly call. Null for every
  // guest-booked paid session, which never requires an account.
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  firstName         String
  lastName          String?
  email             String
  phone             String?
  meetingPreference String         // phone | facetime | google-meet | zoom | other (free text)
  coachingContext   String?        // "how can I help you" — what to coach them on

  scheduledDate     String         // YYYY-MM-DD
  scheduledTime     String         // e.g. "14:00" (24h, America/New_York)

  status            SessionBookingStatus @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  confirmationSentAt      DateTime?
  meetLink                String?  // Google Meet link, set once the calendar event is created
  reminderSentAt          DateTime? // admin SMS "meeting in 1 hour" reminder — set once sent, dedup guard

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

enum PaidSessionType {
  THIRTY_MIN        // $85/person, 1-6 people
  SIXTY_MIN_1ON1    // $150 flat, 1 person
  SIXTY_MIN_1ON2    // $110/person, 1-2 people
  SIXTY_MIN_GROUP   // $65/person, 3-6 people
  PC_WEEKLY_CALL    // Free, 1 person — included weekly call for Private Coaching members
}

enum SessionBookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
}

// ============================================================
// CHAT — AI Coach Conversations
// ============================================================

model ChatConversation {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      ChatMessage[]
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         String
  metadata        Json?
  createdAt       DateTime @default(now())
}

// ============================================================
// EXERCISE DEMO VIDEOS — generated once per exercise, human-approved,
// then reused for every client forever. Never shown to a client unless
// status is APPROVED — an unreviewed AI video could show subtly wrong
// form, which is a real safety risk, not just a quality issue.
// ============================================================

model ExerciseVideo {
  id             String              @id @default(cuid())
  exerciseName   String              // must match exercise-swaps.ts naming exactly
  // The trainer's sex in this specific clip. Two rows exist per exerciseName
  // (one male, one female) so the client-facing player can show whichever is
  // the opposite sex of the logged-in client (AthleteProfile.gender).
  trainerGender  String
  prompt         String              // exact prompt sent to the video model, for reproducibility
  runwayTaskId   String?             // for polling generation status — generation is async
  videoUrl       String?
  status         ExerciseVideoStatus @default(GENERATING)
  generatedAt    DateTime            @default(now())
  approvedAt     DateTime?
  rejectionNote  String?             // why a regeneration was requested, if any

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([exerciseName, trainerGender])
}

enum ExerciseVideoStatus {
  GENERATING   // task submitted to Runway, not yet complete
  NEEDS_REVIEW // video generated, awaiting admin approval
  APPROVED     // visible to clients
  REJECTED     // failed review — needs regeneration
  FAILED       // generation itself failed
}

// ============================================================
// EXERCISE DEMO ILLUSTRATIONS — the "Show Me How" feature's current form.
// Replaces ExerciseVideo above (kept in place, unused, rather than a
// destructive drop) — a clean instructional diagram of body positioning and
// movement direction, not a video. Generated once per exercise (no
// trainer-gender variant — a form diagram isn't gendered), human-approved,
// then reused for every client forever. Never shown to a client unless
// status is APPROVED.
// ============================================================

model ExerciseIllustration {
  id            String                       @id @default(cuid())
  exerciseName  String                       @unique // must match exercise-swaps.ts naming exactly
  prompt        String                       // exact prompt sent to the image model, for reproducibility
  imageUrl      String?                      @db.Text // hosted URL or a data: URI, depending on provider response
  status        ExerciseIllustrationStatus   @default(GENERATING)
  generatedAt   DateTime                     @default(now())
  approvedAt    DateTime?
  rejectionNote String?                      // why a regeneration was requested, if any

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ExerciseIllustrationStatus {
  GENERATING   // request in flight — generation is synchronous, so this is transient
  NEEDS_REVIEW // image generated, awaiting admin approval
  APPROVED     // visible to clients
  REJECTED     // failed review — needs regeneration
  FAILED       // generation itself failed
}
